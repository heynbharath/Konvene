# Postgres connection string (Supabase project). Use the "Transaction pooler"
# URI from Supabase Dashboard -> Project Settings -> Database -> Connection
# string (port 6543, ?pgbouncer=true) — required for serverless deployment,
# and works fine for local dev too.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

JWT_SECRET="change-me-to-a-long-random-string"
QR_SIGNING_SECRET="change-me-to-a-different-long-random-string"

PORT=4000
# Comma-separated list of allowed frontend origins (CORS).
WEB_ORIGIN="http://localhost:3000"

# Certificate PDF storage. Leave both unset for local dev (falls back to
# apps/api/uploads/certificates on local disk). Set both in production —
# serverless hosts wipe local disk between invocations.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Phase 1+ (not required now)
RESEND_API_KEY=""
