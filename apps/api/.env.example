# Local dev default (SQLite, zero setup). For prod, point to Postgres (Supabase/Neon)
# and change the datasource provider in prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./dev.db"

JWT_SECRET="change-me-to-a-long-random-string"
QR_SIGNING_SECRET="change-me-to-a-different-long-random-string"

PORT=4000
WEB_ORIGIN="http://localhost:3000"

# Phase 1+ (not required for Phase 0 MVP)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RESEND_API_KEY=""
